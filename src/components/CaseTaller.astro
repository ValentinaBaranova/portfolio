---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { FIRST_VERSION_PRICE } from '../i18n/translations';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const content = {
  es: {
    eyebrow: 'Caso real · Taller de pintura en Buenos Aires',
    title: 'Control de abonos y asistencia de alumnos para un taller de pintura',
    intro: 'Una profesora de pintura da clases grupales a unas 50 alumnas en Buenos Aires. Cada una paga su mes desde el día en que empezó, y si falta a una clase, puede recuperarla otro día. La profesora me pidió una aplicación para anotar los pagos y ver cuántas clases le quedan a cada alumna.',
    videoLabel: 'Demo de la aplicación del taller',
    problemTitle: 'El problema: los abonos en un cuaderno y las clases de memoria',
    problem: [
      'Los abonos estaban anotados en un cuaderno; cuántas clases le quedaban a cada alumna, solo en la memoria.',
      'A veces no se acordaba si a una alumna todavía le quedaban clases pagas o si ya tenía que pagar, y así perdía plata.',
      'Con 50 alumnas que empezaron en fechas distintas y clases que se recuperan otro día, las cuentas son distintas para cada una.',
    ],
    featuresTitle: 'Control de asistencia, abonos y clases de cada alumno',
    featuresIntro: 'Con letra y botones grandes, para usarla en el celular en medio de la clase.',
    features: [
      { img: 'asistencia', alt: 'Control de asistencia de la clase: marcar qué alumnos faltaron', title: 'Asistencia en un toque', text: 'Se abre en la clase del momento. La profesora marca solo quién faltó; las demás cuentan como presentes y las clases se descuentan solas.' },
      { img: 'alumna', alt: 'Ficha de una alumna: clases que le quedan del abono y días que vino', title: 'Cada alumna, al día', text: 'Cuántas clases le quedan de su mes, si pagó y qué días vino. Ya no hay que recordarlo.' },
      { img: 'pagos', alt: 'Lista de alumnos que deben el abono mensual', title: 'Quién debe', text: 'Quién debe el abono del mes (la cuota) y cuánto se cobró, sin hacer cuentas.' },
      { img: 'registrar-pago', alt: 'Registrar el pago del abono con el monto ya calculado', title: 'Pagos con el monto calculado', text: 'El monto sale de la lista de precios y de las clases de su período, incluida una 5ª clase.' },
    ],
    whatsapp: {
      title: 'Sus clases por WhatsApp',
      alt: 'Pago registrado y botón para enviarle a la alumna sus clases por WhatsApp',
      text: 'Con un toque le manda a cada alumna un mensaje con sus próximas clases, con día y horario: un recordatorio personal que la anima a volver. El mensaje sale escrito; ella solo lo envía.',
      messageLabel: 'El mensaje que recibe la alumna',
      message: "Hola Valeria! Gracias por seguir con las clases 😊 Tu período pagado es del 11/10 al 10/11.\nTus próximas clases (de 3 h):\n• Viernes 23/10, de 10 a 13 h\n• Viernes 30/10, de 10 a 13 h\n• Viernes 6/11, de 10 a 13 h",
    },
    sampleNote: 'Las capturas y el video usan datos de ejemplo.',
    ctaTitle: '¿Tenés un taller, estudio o academia?',
    ctaText: `Si llevás alumnos, turnos o pagos en un cuaderno, planillas o WhatsApp, contame cómo trabajás. La primera versión está lista en 1 semana desde que aprobás el prototipo y cuesta USD ${FIRST_VERSION_PRICE}, con un mes de ajustes incluido.`,
    whatsappText: 'Hola Valentina, vi el caso del taller de pintura y quiero algo parecido para mi negocio.',
    back: 'Volver a proyectos',
    backUrl: '/#projects',
  },
  en: {
    eyebrow: 'Real project · Painting studio in Buenos Aires',
    title: 'Tracking student payments and attendance for a painting studio',
    intro: 'A painting teacher in Buenos Aires gives group classes to about 50 students. Each one pays for her month from the day she started, and if she misses a class, she can make it up another day. The teacher asked me for an app to record payments and check how many classes each student has left.',
    videoLabel: 'Demo of the painting studio app',
    problemTitle: 'The problem: monthly fees in a notebook, classes from memory',
    problem: [
      'Monthly fees were written down in a notebook; how many classes each student had left was only in her memory.',
      'Sometimes she couldn\'t remember whether a student still had paid classes left or was due to pay, and she lost money that way.',
      'With 50 students who started on different dates and classes made up on other days, the numbers are different for everyone.',
    ],
    featuresTitle: 'Attendance, monthly fees and classes for every student',
    featuresIntro: 'With large text and buttons, so she can use it on her phone in the middle of class.',
    features: [
      { img: 'asistencia', alt: 'Class attendance: marking which students missed class', title: 'Attendance in one tap', text: 'It opens on the class happening now. The teacher only marks who missed it; everyone else counts as present and classes are deducted automatically.' },
      { img: 'alumna', alt: 'Student profile: classes left on her monthly fee and days attended', title: 'Every student, up to date', text: 'How many classes she has left this month, whether she paid and which days she came. No need to remember it.' },
      { img: 'pagos', alt: 'List of students who owe their monthly fee', title: 'Who owes', text: 'Who still owes this month\'s fee and how much has been collected, with no calculations.' },
      { img: 'registrar-pago', alt: 'Recording a monthly fee payment with the amount already calculated', title: 'Payments with the amount worked out', text: 'The amount comes from the price list and the classes in her period, including a 5th class.' },
    ],
    whatsapp: {
      title: 'Her classes on WhatsApp',
      alt: 'Payment recorded, with a button to send the student her classes on WhatsApp',
      text: 'One tap sends each student a message with her upcoming classes, with day and time: a personal reminder that encourages her to come back. The message is written for her; she only hits send.',
      messageLabel: 'The message the student gets (in Spanish)',
      message: "Hola Valeria! Gracias por seguir con las clases 😊 Tu período pagado es del 11/10 al 10/11.\nTus próximas clases (de 3 h):\n• Viernes 23/10, de 10 a 13 h\n• Viernes 30/10, de 10 a 13 h\n• Viernes 6/11, de 10 a 13 h",
    },
    sampleNote: 'Screenshots and video use sample data.',
    ctaTitle: 'Do you run a studio, workshop or school?',
    ctaText: `If you track students, bookings or payments in a notebook, spreadsheets or WhatsApp, tell me how you work. The first version is ready 1 week after you approve the prototype and costs USD ${FIRST_VERSION_PRICE}, with a month of adjustments included.`,
    whatsappText: "Hi Valentina, I saw the painting studio case and I'd like something similar for my business.",
    back: 'Back to projects',
    backUrl: '/en/#projects',
  },
}[lang];

const whatsappUrl = `${t('contact.whatsapp.url')}?text=${encodeURIComponent(content.whatsappText)}`;
---

<article class="pt-28 md:pt-32 pb-16 md:pb-24">
  <!-- Intro + video -->
  <section class="max-w-5xl mx-auto px-6">
    <a href={content.backUrl} class="inline-flex items-center gap-1 text-sm font-bold text-slate-500 hover:text-blue-600 transition-colors mb-8">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
      {content.back}
    </a>
    <div class="grid md:grid-cols-[1fr_auto] gap-10 md:gap-16 items-center">
      <div>
        <p class="text-sm font-bold uppercase tracking-wider text-blue-600 mb-4">{content.eyebrow}</p>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-slate-900 mb-6 text-balance">{content.title}</h1>
        <p class="text-lg md:text-xl text-slate-600 leading-relaxed">{content.intro}</p>
      </div>
      <div class="flex justify-center">
        <video
          src="/projects/taller/demo.mp4"
          poster="/projects/taller/demo-poster.jpg"
          aria-label={content.videoLabel}
          autoplay
          muted
          loop
          playsinline
          controls
          preload="metadata"
          class="w-64 md:w-72 rounded-[2rem] border-[6px] border-slate-900 shadow-2xl bg-slate-900"
        />
      </div>
    </div>
  </section>

  <!-- Problem -->
  <section class="max-w-3xl mx-auto px-6 mt-20 md:mt-28">
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 mb-4">{content.problemTitle}</h2>
    <div class="h-1 w-12 bg-blue-600 rounded-full mb-8"></div>
    <ul class="space-y-4">
      {content.problem.map((p) => (
        <li class="flex gap-3 text-lg text-slate-600 leading-relaxed">
          <span class="mt-2.5 w-2 h-2 rounded-full bg-blue-600 shrink-0"></span>
          <span>{p}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Features -->
  <section class="bg-slate-50 mt-20 md:mt-28 py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 mb-4">{content.featuresTitle}</h2>
      <div class="h-1 w-12 bg-blue-600 rounded-full mb-6"></div>
      <p class="text-lg text-slate-600 leading-relaxed mb-12">{content.featuresIntro}</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 sm:gap-8">
        {content.features.map((f) => (
          <div class="flex flex-col items-center sm:items-start">
            <img
              src={`/projects/taller/${f.img}.jpg`}
              alt={f.alt}
              width="768"
              height="1688"
              loading="lazy"
              class="w-52 sm:w-full h-auto rounded-2xl border border-slate-200 shadow-md mb-6"
            />
            <h3 class="text-lg font-bold text-slate-900 mb-2 text-center sm:text-left">{f.title}</h3>
            <p class="text-slate-600 leading-relaxed text-center sm:text-left">{f.text}</p>
          </div>
        ))}
      </div>
      <div class="mt-16 grid md:grid-cols-[auto_1fr] gap-8 md:gap-12 items-center">
        <img
          src="/projects/taller/whatsapp.jpg"
          alt={content.whatsapp.alt}
          width="768"
          height="1688"
          loading="lazy"
          class="w-52 md:w-56 h-auto mx-auto rounded-2xl border border-slate-200 shadow-md"
        />
        <div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">{content.whatsapp.title}</h3>
          <p class="text-slate-600 leading-relaxed mb-6 max-w-xl">{content.whatsapp.text}</p>
          <p class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">{content.whatsapp.messageLabel}</p>
          <div class="max-w-sm bg-white border border-slate-200 rounded-2xl rounded-tl-sm shadow-sm px-4 py-3 text-slate-800 leading-relaxed whitespace-pre-line">{content.whatsapp.message}</div>
        </div>
      </div>
      <p class="text-sm text-slate-400 mt-10">{content.sampleNote}</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-5xl mx-auto px-6 mt-20 md:mt-28">
    <div class="bg-slate-900 rounded-3xl px-6 py-10 md:p-14 text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4 text-balance">{content.ctaTitle}</h2>
      <p class="text-slate-300 text-lg leading-relaxed max-w-2xl mx-auto mb-8">{content.ctaText}</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="px-8 py-4 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg transition-all">
          {t('contact.whatsapp')}
        </a>
        <a href={t('contact.email.url')} class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-lg transition-all">
          {t('contact.email')}
        </a>
      </div>
    </div>
  </section>
</article>
