---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const steps = [
  { title: t('process.1.title'), description: t('process.1.desc') },
  { title: t('process.2.title'), description: t('process.2.desc') },
  { title: t('process.3.title'), description: t('process.3.desc') },
  { title: t('process.4.title'), description: t('process.4.desc') },
];
---

<section id="process" class="py-16 md:py-24 border-t border-slate-100">
  <div class="max-w-5xl mx-auto px-6">
    <div class="text-center mb-12">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 mb-4 text-balance">{t('process.title')}</h2>
      <div class="h-1 w-12 bg-blue-600 rounded-full mx-auto mb-6"></div>
      <p class="text-lg text-slate-600">{t('process.subtitle')}</p>
    </div>

    <ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {steps.map((step, i) => (
        <li class="relative">
          <div class="w-10 h-10 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold mb-5">
            {i + 1}
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">{step.title}</h3>
          <p class="text-slate-600 leading-relaxed">{step.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
