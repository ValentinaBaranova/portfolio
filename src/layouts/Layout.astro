---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	enUrl?: string;
	esUrl?: string;
	noindex?: boolean;
}

const { title, description, enUrl, esUrl, noindex } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// GA4 Measurement ID should be provided via PUBLIC_GA_MEASUREMENT_ID
const GA_MEASUREMENT_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;

const currentPath = Astro.url.pathname;
const finalEnUrl = enUrl || (lang === 'es' ? `/en${currentPath === '/' ? '/' : currentPath}` : currentPath);
const finalEsUrl = esUrl || (lang === 'en' ? currentPath.replace(/^\/en/, '') || '/' : currentPath);

const siteTitle = title || t('site.title');
const siteDescription = description || t('site.description');

const personStructuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Valentina Baranova",
  "url": Astro.url.origin,
  "jobTitle": t('site.role'),
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Buenos Aires",
    "addressCountry": "AR"
  },
  "sameAs": [
    t('contact.linkedin.url'),
    "https://github.com/ValentinaBaranova"
  ]
};

const localBusinessStructuredData = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": `Valentina Baranova — ${t('site.role')}`,
  "description": t('site.description'),
  "url": Astro.url.origin,
  "telephone": "+5491126593700",
  "email": "vbaranova87@gmail.com",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Buenos Aires",
    "addressCountry": "AR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -34.6037,
    "longitude": -58.3816
  },
  "priceRange": "$$"
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg??v=2" />
		<meta name="generator" content={Astro.generator} />

		{noindex ? (
			<meta name="robots" content="noindex" />
		) : (
			<>
				<link rel="canonical" href={new URL(currentPath, Astro.site)} />

				<!-- Hreflang Tags -->
				<link rel="alternate" hreflang="en" href={new URL(finalEnUrl, Astro.site)} />
				<link rel="alternate" hreflang="es" href={new URL(finalEsUrl, Astro.site)} />
				<link rel="alternate" hreflang="x-default" href={new URL(finalEsUrl, Astro.site)} />
			</>
		)}

		<title>{siteTitle}</title>
		<meta name="description" content={siteDescription} />
		<meta name="keywords" content={t('site.keywords')} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(personStructuredData)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(localBusinessStructuredData)} />

		{import.meta.env.PROD && GA_MEASUREMENT_ID && (
			<>
				<script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
				<script
					is:inline
					set:html={`
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', '${GA_MEASUREMENT_ID}', { 'anonymize_ip': true });
          `}
				/>
			</>
		)}
	</head>
	<body class="bg-white text-slate-900 selection:bg-blue-100 selection:text-blue-900 antialiased flex flex-col min-h-screen">
		<header class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-slate-100">
			<nav class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
				<a href={lang === 'es' ? '/' : `/${lang}/`} class="font-bold text-xl tracking-tight">
					Valentina Baranova
				</a>
				<div class="flex items-center gap-6">
					<div class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600">
						<a href={lang === 'es' ? '/#projects' : '/en/#projects'} class="hover:text-blue-600 transition-colors">
							{t('nav.projects')}
						</a>
						<a href={lang === 'es' ? '/blog/' : '/en/blog/'} class="hover:text-blue-600 transition-colors">
							{t('nav.blog')}
						</a>
						<a href={lang === 'es' ? '/#contact' : '/en/#contact'} class="hover:text-blue-600 transition-colors">
							{t('nav.contact')}
						</a>
					</div>
					<div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider">
						<a 
							href={finalEnUrl} 
							class={lang === 'en' ? 'text-blue-600' : 'text-slate-400 hover:text-slate-600 transition-colors'}
						>
							EN
						</a>
						<span class="text-slate-200">|</span>
						<a 
							href={finalEsUrl} 
							class={lang === 'es' ? 'text-blue-600' : 'text-slate-400 hover:text-slate-600 transition-colors'}
						>
							ES
						</a>
					</div>
				</div>
			</nav>
		</header>
		<main class="flex-1">
			<slot />
		</main>
		<footer class="bg-slate-50 border-t border-slate-100 py-12">
			<div class="max-w-5xl mx-auto px-6 text-center">
				<p class="text-slate-900 font-bold mb-2">
					&copy; {new Date().getFullYear()} Valentina Baranova · Buenos Aires
				</p>
				<p class="text-slate-500 text-sm">
					{t('site.role')}
				</p>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	html {
		scroll-behavior: smooth;
	}
</style>
