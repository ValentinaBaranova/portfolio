---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada — Valentina Baranova" noindex>
  <div class="max-w-5xl mx-auto px-6 pt-32 pb-20 text-center">
    <p class="text-sm font-semibold text-blue-600 mb-4">404</p>
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-slate-900 mb-6">Página no encontrada</h1>
    <p class="text-xl text-slate-600 mb-10">Page not found</p>
    <div class="flex justify-center gap-6 text-sm font-semibold text-blue-600">
      <a href="/" class="hover:text-blue-800 transition-colors">Ir al inicio</a>
      <a href="/en/" class="hover:text-blue-800 transition-colors">Go to home</a>
    </div>
  </div>
</Layout>
